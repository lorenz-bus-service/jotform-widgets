          valid: true,
          value: `${selectedOption.value}:${selectedOption.text}`
          // value: JSON.stringify({
          //   value: selectedOption.value,
          //   text: selectedOption.text
          // })
      }
      console.log('msg',msg)

      // send value to JotForm
      JFCustomWidget.sendData(msg)

    },true); 

  });
  */
</script>