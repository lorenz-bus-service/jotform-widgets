<select class="form-select" id="selectDriverName" autocomplete="off" aria-label="Select a driver">
  <option></option>
  <% records.forEach(function(driver) { %>
      <option 
    value="<%= driver.id %>" 
    data-first-name="<%= driver.fields['First Name'] %>" 
    data-last-name="<%= driver.fields['Last Name'] %>"
      >
    <%= driver.fields['Employee Name'] %>
      </option>
  <% }); %>
</select>
<div class="form-text">version: <%= version %></div>
<div id="widget-error" class="form-text text-danger" style="display:none;"></div>

<script>
  // Using Vanilla JS to handle the change event
  document.addEventListener('DOMContentLoaded',() => {
    console.log('DOMContentLoaded');

    document.getElementById('selectDriverName')
      .addEventListener("change", function(){
        console.log('selectDriverName.change');

        const selectedOption = selectDriverName.options[selectDriverName.selectedIndex]

        console.log('value', selectedOption.value);
        console.log('text', selectedOption.text);
        console.log('data-first-name', selectedOption.dataset.firstName);
        console.log('data-last-name', selectedOption.dataset.lastName);

        // JFCustomWidget.setFieldsValueByLabel([
        //   {
        //     label: "First Name",
        //     value: selectedOption.dataset.firstName
        //   },
        //   {
        //     label: "Last Name",
        //     value: selectedOption.dataset.lastName
        //   },
        // ]);

        // set indicated fields in the Full Name widget
        const firstNameFieldId = JFCustomWidget.getWidgetSetting('first-name-field-id') || 'first_13';
        const lastNameFieldId = JFCustomWidget.getWidgetSetting('last-name-field-id') || 'last_13';

        JFCustomWidget.storeToField(firstNameFieldId, selectedOption.dataset.firstName);
        JFCustomWidget.storeToField(lastNameFieldId, selectedOption.dataset.lastName);
        
        // const value = {
        //   recordId: selectedOption.value,
        //   employeeName: selectedOption.text,
        //   firstName: selectedOption.dataset.firstName,
        //   lastName: selectedOption.dataset.lastName
        // }
        // console.log('value', value);

        // send value to JotForm
        // JFCustomWidget.sendData({
        //   valid: true,
        //   value: JSON.stringify(value)
        // })

      });

    //always subscribe to ready event and implement widget related code
    //inside callback function , it is the best practice while developing widgets
    JFCustomWidget.subscribe("ready", function(){
      console.log('JFCustomWidget.ready');

      const airtableApiKey = JFCustomWidget.getWidgetSetting('x-airtable-api-key');
      console.log('x-airtable-api-key',airtableApiKey);

      const firstNameFieldId = JFCustomWidget.getWidgetSetting('first-name-field-id');
      console.log('first-name-field-id',firstNameFieldId);

      const lastNameFieldId = JFCustomWidget.getWidgetSetting('last-name-field-id');
      console.log('last-name-field-id',lastNameFieldId);

      // todo: add error text to the widget
      if (!firstNameFieldId || !lastNameFieldId) {
        const errorDiv = document.getElementById('widget-error');
        errorDiv.style.display = 'block';
        let missingFields = [];
        if (!firstNameFieldId) missingFields.push('First Name Field ID');
        if (!lastNameFieldId) missingFields.push('Last Name Field ID');
        errorDiv.textContent = 'Missing: ' + missingFields.join(', ');
      }

    });

  });

