<select class="form-select" id="selectTrainer" autocomplete="off" aria-label="Choose a trainee">
  <option></option>
  <% records.forEach(function(employee) { %>
    <option value="<%= employee.id %>">
      <%= employee.fields['Full Name'] %>
    </option>
  <% }); %>
</select>
<div class="form-text">version: <%= version %></div>
<!-- <div id="widget-error" class="form-text text-danger" style="display:none;"></div> -->

<script>
document.addEventListener('DOMContentLoaded',() => {
  console.log('DOMContentLoaded');

  // register a change event listener for the select element
  document.getElementById('selectTrainer')
    .addEventListener("change", function(){
      console.log('selectTrainer.change');

      const selectTrainer = document.getElementById('selectTrainer')
      const selectedOption = selectTrainer.options[selectTrainer.selectedIndex]

      console.log('value', selectedOption.value);
      console.log('text', selectedOption.text);

      // pass the value to the associated small-text field
      JFCustomWidget.setFieldsValueByLabel([
        {
          label: JFCustomWidget.getWidgetSetting('jotform-id-field') || "Trainer ID",
          value: selectedOption.value
        },
      ]);

        const text = selectedOption.text
        console.log('text', text);

        if (text) {
          console.log('sendData()');
          // return the text as the widget's value
          JFCustomWidget.sendData({
            value: text
          });
        }

    });

  //always subscribe to ready event and implement widget related code
  //inside callback function , it is the best practice while developing widgets
  JFCustomWidget.subscribe("ready", function(){
    console.log('JFCustomWidget.ready');

    console.log('jotform-id-field',JFCustomWidget.getWidgetSetting('jotform-id-field'));
    console.log('airtable-display-field',JFCustomWidget.getWidgetSetting('airtable-display-field'));

    //subscribe to form submit event
    JFCustomWidget.subscribe("submit", function(){
      console.log('JFCustomWidget.submit');

      const selectTrainer = document.getElementById('selectTrainer')
      const selectedOption = selectTrainer.options[selectTrainer.selectedIndex]

      console.log('value', selectedOption.value);
      console.log('text', selectedOption.text);

      // pass the value to the associated small-text field
      JFCustomWidget.setFieldsValueByLabel([
        {
          label: JFCustomWidget.getWidgetSetting('jotform-id-field') || "Trainer ID",
          value: selectedOption.value
        },
      ]);

      const data = {
        valid: true,
        // valid: !!selectedOption.text,
        value: selectedOption.text
      };
      console.log('data', data);

      // return the text as the widget's value
      console.log('sendSubmit()');
      JFCustomWidget.sendSubmit(data);

    });

  });

});
</script>